---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const videos = (await getCollection('videos')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Videos" description="Videos de Araceli Bonfigli">
  <header class="page-hero">
    <div class="container">
      <p class="section-eyebrow">
        <Icon name="video" size={14} />
        Audiovisual
      </p>
      <h1>Videos</h1>
      <p>Presentaciones, sesiones y obras en vivo.</p>
    </div>
  </header>

  <div class="container section video-grid">
    {
      videos.map((video) => (
        <article class="video-card reveal" id={video.id}>
          <div class="video-frame">
            <iframe
              src={`https://www.youtube.com/embed/${video.data.youtubeId}`}
              title={video.data.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
          <h2>{video.data.title}</h2>
          {video.data.subtitle && <p>{video.data.subtitle}</p>}
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-lg);
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.85rem;
    background: #111;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-card h2 {
    font-size: 1.45rem;
    margin-bottom: 0.25rem;
  }

  .video-card p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
