---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/musica/', label: 'Música', icon: 'music' as const },
  { href: '/estudio/', label: 'Estudio', icon: 'studio' as const },
  { href: '/videos/', label: 'Videos', icon: 'video' as const },
  { href: '/libros/', label: 'Libros', icon: 'book' as const },
  { href: '/galeria/', label: 'Galería', icon: 'gallery' as const },
  { href: '/bio/', label: 'Bio', icon: 'person' as const },
];

function isActive(href: string) {
  return path === href || path.startsWith(href);
}
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/">{siteTitle}</a>
    <div class="header-actions">
      <ThemeToggle />
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
      >
        <span class="sr-only">Menú</span>
        <span></span>
        <span></span>
      </button>
      <nav class="site-nav" id="site-nav" data-nav>
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  <Icon name={link.icon} size={16} />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-header);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .site-nav a[aria-current='page'],
  .site-nav a:hover {
    color: var(--color-accent);
  }

  .nav-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 1.35rem;
    height: 2px;
    margin: 0.35rem auto;
    background: var(--color-ink);
    transition: transform 0.25s var(--ease);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 960px) {
    .nav-toggle {
      display: block;
      order: 2;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      background: var(--color-paper);
      border-bottom: 1px solid var(--color-line);
      padding: 1rem 1.25rem 1.5rem;
      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
      transition:
        transform 0.35s var(--ease),
        opacity 0.35s var(--ease);
    }

    .site-nav.is-open {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0.85rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  const root = document.documentElement;
  const themeBtn = document.querySelector('[data-theme-toggle]');

  const applyTheme = (theme: 'light' | 'dark') => {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme-mode', theme);
    themeBtn?.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro',
    );
  };

  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
</script>
