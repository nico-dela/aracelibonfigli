---
import { Image } from 'astro:assets';
import { cloudinaryThumb } from '../utils/cloudinary';

interface ImageItem {
  src: string;
  alt?: string;
}

interface Props {
  images: ImageItem[];
  title: string;
}

const { images, title } = Astro.props;
const items = images.map((image) => ({
  ...image,
  thumb: cloudinaryThumb(image.src, 480),
}));
---

<div class="gallery-grid" data-gallery={title}>
  {
    items.map((image, index) => (
      <button
        type="button"
        class="gallery-thumb"
        data-gallery-open
        data-index={index}
        data-full-src={image.src}
        aria-label={`Ver ${image.alt ?? title} (${index + 1})`}
      >
        <Image
          src={image.thumb}
          alt={image.alt ?? title}
          width={480}
          height={480}
          widths={[240, 480]}
          sizes="(max-width: 700px) 45vw, 10rem"
          decoding="async"
          loading={index < 8 ? 'eager' : 'lazy'}
          fetchpriority={index < 4 ? 'high' : 'auto'}
          data-gallery-thumb
        />
      </button>
    ))
  }
</div>

<dialog class="gallery-dialog" data-gallery-dialog>
  <div class="gallery-dialog-inner">
    <button type="button" class="gallery-close" data-gallery-close aria-label="Cerrar">
      ×
    </button>
    <button type="button" class="gallery-nav prev" data-gallery-prev aria-label="Anterior">
      ‹
    </button>
    <div class="gallery-stage" data-gallery-stage aria-live="polite">
      <div class="gallery-spinner" data-gallery-spinner hidden aria-hidden="true"></div>
      <img data-gallery-image alt="" decoding="async" />
    </div>
    <button type="button" class="gallery-nav next" data-gallery-next aria-label="Siguiente">
      ›
    </button>
    <p class="gallery-caption" data-gallery-caption></p>
  </div>
</dialog>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.65rem;
  }

  .gallery-thumb {
    border: 0;
    padding: 0;
    background: var(--color-surface);
    cursor: pointer;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }

  .gallery-thumb:hover img {
    transform: scale(1.04);
  }

  .gallery-dialog {
    border: 0;
    padding: 0;
    width: min(92vw, 56rem);
    max-width: 100%;
    background: transparent;
  }

  .gallery-dialog::backdrop {
    background: rgba(10, 14, 12, 0.82);
  }

  .gallery-dialog-inner {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.75rem;
  }

  .gallery-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: min(78vh, 40rem);
    width: 100%;
  }

  .gallery-stage.is-loading img {
    opacity: 0.35;
  }

  .gallery-stage img {
    max-height: 78vh;
    width: auto;
    max-width: 100%;
    transition: opacity 0.25s var(--ease);
  }

  .gallery-spinner {
    position: absolute;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid color-mix(in srgb, #f7f4ef 35%, transparent);
    border-top-color: #f7f4ef;
    border-radius: 50%;
    animation: gallery-spin 0.7s linear infinite;
    z-index: 1;
  }

  .gallery-spinner[hidden] {
    display: none;
  }

  @keyframes gallery-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .gallery-close,
  .gallery-nav {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(247, 244, 239, 0.28);
    border-radius: 999px;
    padding: 0;
    background: rgba(12, 18, 16, 0.55);
    color: #f7f4ef;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      background 0.25s var(--ease),
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .gallery-close:hover,
  .gallery-nav:hover {
    background: rgba(12, 18, 16, 0.78);
    border-color: rgba(247, 244, 239, 0.5);
  }

  .gallery-close:focus-visible,
  .gallery-nav:focus-visible {
    outline: 2px solid #f7f4ef;
    outline-offset: 2px;
  }

  .gallery-close {
    top: 0.65rem;
    right: 0.65rem;
  }

  .gallery-nav.prev {
    left: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery-nav.next {
    right: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery-nav.prev:hover,
  .gallery-nav.next:hover {
    transform: translateY(-50%);
  }

  .gallery-caption {
    margin: 0;
    color: #f7f4ef;
    text-align: center;
  }
</style>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>
