---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const site = await getEntry('settings', 'site');
const siteData = site!.data;

const {
  title,
  description = siteData.metaDescription,
  bodyClass = '',
} = Astro.props;

const pageTitle = title
  ? `${title} · ${siteData.title}`
  : `${siteData.title} — Artista y Docente`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Araceli Bonfigli, compositora, productora, escritora, docente, música independiente"
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    <div class="site-wrap">
      <Header siteTitle={siteData.title} />
      <main id="contenido-principal" class="site-main" tabindex="-1">
        <slot />
      </main>
      <Footer linktree={siteData.linktree} />
    </div>
    <script>
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
